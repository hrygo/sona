{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sona://meeting-assistant/v1/transcript-response.schema.json",
  "title": "TranscriptResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["meeting_id", "transcript_revision", "content_revision", "segments"],
  "properties": {
    "meeting_id": {"type": "string", "format": "uuid"},
    "transcript_revision": {"type": "integer", "minimum": 0},
    "content_revision": {"type": "integer", "minimum": 0},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "display_blocks": {"type": "array", "items": {"$ref": "#/$defs/display_block"}}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "speaker_key", "speaker_name", "start_ms", "end_ms", "text", "source_epoch"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "order": {"type": "integer", "minimum": 0},
        "speaker_key": {"type": "string", "minLength": 1},
        "speaker_name": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "translation": {"type": ["string", "null"]},
        "detected_language": {"type": ["string", "null"]},
        "source_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "display_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "item_ids", "source_ids", "order", "speaker_key", "speaker_name", "speaker_status", "speaker_color_token", "start_ms", "end_ms", "text", "timing_quality", "is_partial"],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "item_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "order": {"type": "integer", "minimum": 0},
        "speaker_key": {"type": ["string", "null"]},
        "speaker_name": {"type": ["string", "null"]},
        "speaker_status": {"enum": ["identified", "anonymous", "pending", "off", "degraded"]},
        "speaker_color_token": {"type": "string", "minLength": 1},
        "start_ms": {"type": ["integer", "null"], "minimum": 0},
        "end_ms": {"type": ["integer", "null"], "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "timing_quality": {"enum": ["aligned", "unavailable"]},
        "is_partial": {"type": "boolean"}
      }
    }
  }
}
